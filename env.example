# Persona selection and raw chunk visualization are restricted to a local demo.
DEMO_MODE=true
HOST=127.0.0.1
PORT=3002
# Explicit opt-in for showing why retrieval without authorization leaks data.
ALLOW_INSECURE_COMPARISON=false

OPENFGA_API_URL=http://127.0.0.1:8081
OPENFGA_STORE_ID=
OPENFGA_AUTHORIZATION_MODEL_ID=
# Required together for a hosted FGA service; leave empty for a local instance.
OPENFGA_CLIENT_ID=
OPENFGA_CLIENT_SECRET=
OPENFGA_TOKEN_ISSUER=
OPENFGA_AUDIENCE=

CHROMA_URL=http://127.0.0.1:8000
# Optional until chat generation is used. This key stays on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
